// -----------------------------------------------------------------------------
// Optional local overrides. Copy to `Secrets.xcconfig` (git-ignored) if needed.
//
// The app is fully on-device (SimpleFIN + file import) and requires no secrets
// or backend. What you might set here is signing, for running on a physical
// device with your own Apple developer account.
//
// Both are needed together: a device build has to register the app identifier
// with your team, and only this project's team can register com.vratnakaram.*.
// -----------------------------------------------------------------------------

// DEVELOPMENT_TEAM = ABCDE12345
// BUNDLE_ID_PREFIX = com.yourname
